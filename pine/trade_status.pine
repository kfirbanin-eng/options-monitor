//@version=6
// Mirror of rules.py: EMA 8/13/21 + Parabolic SAR (0.02/0.2) -> GREEN / YELLOW / RED.
// Direction "both": the candles show the trend either way (up = calls, down = puts).
// Direction "call" / "put": the candles score that one trade, exactly like the monitor.
// Alert-only: no orders.
// Pivots: the last 2 pivot highs and the last 2 pivot lows are always connected (any timeframe),
// the formation is named (broadening / cone / channel), and a shooting star at the top line or a
// hammer at the bottom line (15/30/60 min candles, trading hours only) is marked and alerted. Pivots are confirmed after "bars right", so
// nothing repaints.
indicator("Options Monitor Status", overlay = true, max_lines_count = 50, max_labels_count = 300)

dir      = input.string("both", "Direction", options = ["both", "call", "put"])
stopLvl  = input.float(0.0, "Original stop (0 = off)")
t1Lvl    = input.float(0.0, "T1 (0 = off)")
t2Lvl    = input.float(0.0, "T2 (0 = off)")

e8  = ta.ema(close, 8)
e13 = ta.ema(close, 13)
e21 = ta.ema(close, 21)
sar = ta.sar(0.02, 0.02, 0.2)

// Status of a trade on side s (+1 call, -1 put): 2 GREEN, 1 YELLOW fading, 0.5 YELLOW mixed, 0 RED
statusFor(float s, bool useLevels) =>
    sarWith = s > 0 ? sar < close : sar > close
    levelRed = useLevels and (stopLvl > 0 and s * ((s > 0 ? low : high) - stopLvl) <= 0 or t2Lvl > 0 and s * ((s > 0 ? high : low) - t2Lvl) >= 0)
    red   = s * (close - e21) <= 0 or (not sarWith and s * (close - e13) <= 0) or levelRed
    green = not red and s * (close - e8) > 0 and s * (e8 - e13) > 0 and s * (e13 - e21) > 0 and sarWith
    fade  = not red and not green and s * (close - e8) <= 0 and s * (close - e13) > 0 and s * (close - e21) > 0
    st = red ? 0.0 : green ? 2.0 : fade ? 1.0 : 0.5
    cand = green ? sar : fade ? (sarWith ? (s > 0 ? math.max(e13, sar) : math.min(e13, sar)) : e13) : na
    [st, cand]

[upSt, upCand] = statusFor(1.0, dir == "call")
[dnSt, dnCand] = statusFor(-1.0, dir == "put")

// Trend either way: +2 strong up, +1 up fading, -2 strong down, -1 down fading, 0 mixed / chop
trend = upSt == 2 ? 2.0 : dnSt == 2 ? -2.0 : upSt == 1 ? 1.0 : dnSt == 1 ? -1.0 : 0.0

float status = na
float cand = na
color bc = na
if dir == "both"
    status := trend
    cand := trend > 0 ? upCand : trend < 0 ? dnCand : na
    bc := trend == 2 ? color.green : trend == 1 ? color.new(color.green, 60) : trend == -2 ? color.red : trend == -1 ? color.new(color.red, 60) : color.gray
else
    status := dir == "call" ? upSt : dnSt
    cand := dir == "call" ? upCand : dnCand
    bc := status == 0 ? color.red : status == 2 ? color.green : color.yellow

plot(e8,  "EMA8",  color.new(color.blue, 0))
plot(e13, "EMA13", color.new(color.orange, 0))
plot(e21, "EMA21", color.new(color.purple, 0))
plot(sar, "PSAR",  color.gray, style = plot.style_cross)
plot(status, "Status", display = display.data_window)
plot(cand, "Candidate stop", color.yellow, style = plot.style_circles)
plot(stopLvl > 0 ? stopLvl : na, "Stop", color.red, style = plot.style_linebr)
plot(t1Lvl > 0 ? t1Lvl : na, "T1", color.lime, style = plot.style_linebr)
plot(t2Lvl > 0 ? t2Lvl : na, "T2", color.green, style = plot.style_linebr)
barcolor(bc)

// Trade alerts (use with Direction call / put)
alertcondition(status == 0 and status[1] != 0, "Turned RED", "Trade status RED - exit per plan")
alertcondition(status != status[1], "Status changed", "Trade status changed")
// Trend alerts (use with Direction both)
alertcondition(trend == 2 and trend[1] != 2, "Strong uptrend started", "EMA stack + PSAR aligned UP - call setup")
alertcondition(trend == -2 and trend[1] != -2, "Strong downtrend started", "EMA stack + PSAR aligned DOWN - put setup")

// ---------------------------------------------------------------------------
// Pivots, range lines, formation (chart timeframe)
// ---------------------------------------------------------------------------
grpP      = "Pivots / setups"
pvLeft    = input.int(5, "Pivot bars left", minval = 1, group = grpP)
pvRight   = input.int(3, "Pivot bars right (confirmation delay)", minval = 1, group = grpP)
tolAtr    = input.float(0.3, "Near-line tolerance (x ATR14)", minval = 0, step = 0.05, group = grpP)
wickMul   = input.float(2.0, "Wick at least x body", minval = 1, step = 0.25, group = grpP)
showLines = input.bool(true, "Draw pivot lines", group = grpP)

grpS      = "Shooter / hammer setups"
setupSyms = input.string("ALL", "Tickers: ALL, or a comma list (e.g. SPY,QQQ)", group = grpS)
use15     = input.bool(true, "Use 15 min candles", group = grpS)
use30     = input.bool(true, "Use 30 min candles", group = grpS)
use60     = input.bool(true, "Use 60 min candles", group = grpS)
rthSess   = input.session("0930-1600", "Trading hours (ET)", group = grpS)

// Last 2 pivot highs / lows of the timeframe this runs on
pivots() =>
    ph = ta.pivothigh(high, pvLeft, pvRight)
    pl = ta.pivotlow(low, pvLeft, pvRight)
    var float h1 = na
    var float h2 = na
    var int hx1 = na
    var int hx2 = na
    var float l1 = na
    var float l2 = na
    var int lx1 = na
    var int lx2 = na
    if not na(ph)
        h1 := h2
        hx1 := hx2
        h2 := ph
        hx2 := bar_index - pvRight
    if not na(pl)
        l1 := l2
        lx1 := lx2
        l2 := pl
        lx2 := bar_index - pvRight
    [ph, pl, h1, hx1, h2, hx2, l1, lx1, l2, lx2]

formName(float h1, float h2, float l1, float l2) =>
    hh = h2 > h1
    hl = l2 > l1
    na(h1) or na(l1) ? "" : hh and not hl ? "Broadening" : not hh and hl ? "Cone (contracting)" : hh and hl ? "Rising channel" : "Falling channel"

// Shooting star at the top line / hammer at the bottom line, regular trading hours only
rangeSetup() =>
    [ph, pl, h1, hx1, h2, hx2, l1, lx1, l2, lx2] = pivots()
    upNow = na(hx1) ? na : h2 + (h2 - h1) / (hx2 - hx1) * (bar_index - hx2)
    dnNow = na(lx1) ? na : l2 + (l2 - l1) / (lx2 - lx1) * (bar_index - lx2)
    body    = math.abs(close - open)
    rng     = high - low
    upWick  = high - math.max(open, close)
    loWick  = math.min(open, close) - low
    bodyRef = math.max(body, rng * 0.05)
    shooter = rng > 0 and upWick >= wickMul * bodyRef and loWick <= bodyRef and math.max(open, close) <= low + rng * 0.4
    hammer  = rng > 0 and loWick >= wickMul * bodyRef and upWick <= bodyRef and math.min(open, close) >= high - rng * 0.4
    tol   = tolAtr * ta.atr(14)
    atTop = not na(upNow) and high >= upNow - tol and close <= upNow + tol
    atBot = not na(dnNow) and low <= dnNow + tol and close >= dnNow - tol
    inRth = not na(time(timeframe.period, rthSess, "America/New_York"))
    [inRth and shooter and atTop, inRth and hammer and atBot, formName(h1, h2, l1, l2), high, low]

// Chart-timeframe pivot lines and formation
[cph, cpl, ch1, chx1, ch2, chx2, cl1, clx1, cl2, clx2] = pivots()
upNowC = na(chx1) ? na : ch2 + (ch2 - ch1) / (chx2 - chx1) * (bar_index - chx2)
dnNowC = na(clx1) ? na : cl2 + (cl2 - cl1) / (clx2 - clx1) * (bar_index - clx2)
form = formName(ch1, ch2, cl1, cl2)

var line upL = na
var line dnL = na
if showLines and not na(cph) and not na(chx1)
    line.delete(upL)
    upL := line.new(chx1, ch1, chx2, ch2, extend = extend.right, color = color.new(color.red, 0), width = 2)
if showLines and not na(cpl) and not na(clx1)
    line.delete(dnL)
    dnL := line.new(clx1, cl1, clx2, cl2, extend = extend.right, color = color.new(color.green, 0), width = 2)

var label formLbl = na
if barstate.islast and form != "" and not na(upNowC) and not na(dnNowC)
    label.delete(formLbl)
    formLbl := label.new(bar_index + 3, (upNowC + dnNowC) / 2, form, style = label.style_label_left, color = color.new(color.blue, 70), textcolor = color.white, size = size.small)

plotshape(not na(cph), "Pivot high", shape.circle, location.abovebar, color.new(color.red, 40), offset = -pvRight, size = size.tiny)
plotshape(not na(cpl), "Pivot low", shape.circle, location.belowbar, color.new(color.green, 40), offset = -pvRight, size = size.tiny)

newForm = form != form[1] and form != ""
alertcondition(newForm and form == "Broadening", "Broadening formation", "Broadening formation on {{ticker}} {{interval}}")
alertcondition(newForm and form == "Cone (contracting)", "Cone formation", "Cone (contracting) formation on {{ticker}} {{interval}}")

// ---------------------------------------------------------------------------
// Shooter / hammer on 15 / 30 / 60 min, trading hours only (all tickers, or the ones listed)
// ---------------------------------------------------------------------------
symList = str.upper(str.replace_all(setupSyms, " ", ""))
symOk = symList == "ALL" or symList == "" or str.contains("," + symList + ",", "," + syminfo.ticker + ",")
tfOk(simple string tf) => timeframe.in_seconds() <= timeframe.in_seconds(tf)

// Checked on the chart bar that closes together with the 15/30/60 candle, so the candle is final
// and the alert fires the moment it closes (no repaint once the bar is confirmed).
[ss15, hb15, f15, hi15, lo15] = request.security(syminfo.tickerid, "15", rangeSetup())
[ss30, hb30, f30, hi30, lo30] = request.security(syminfo.tickerid, "30", rangeSetup())
[ss60, hb60, f60, hi60, lo60] = request.security(syminfo.tickerid, "60", rangeSetup())

on15 = symOk and use15 and tfOk("15") and time_close == time_close("15")
on30 = symOk and use30 and tfOk("30") and time_close == time_close("30")
on60 = symOk and use60 and tfOk("60") and time_close == time_close("60")

sh15 = on15 and ss15
sh30 = on30 and ss30
sh60 = on60 and ss60
hm15 = on15 and hb15
hm30 = on30 and hb30
hm60 = on60 and hb60

// Setups must pop: magenta = shooter at the TOP, cyan = hammer at the BOTTOM.
// Candle, background stripe and a big label. No other part of the script uses these two colors.
SHOOT_C = #FF00FF
HAMMER_C = #00E5FF
plotshape(sh15, "Shooter 15m", shape.triangledown, location.abovebar, SHOOT_C, display = display.data_window)
plotshape(sh30, "Shooter 30m", shape.triangledown, location.abovebar, SHOOT_C, display = display.data_window)
plotshape(sh60, "Shooter 60m", shape.triangledown, location.abovebar, SHOOT_C, display = display.data_window)
plotshape(hm15, "Hammer 15m", shape.triangleup, location.belowbar, HAMMER_C, display = display.data_window)
plotshape(hm30, "Hammer 30m", shape.triangleup, location.belowbar, HAMMER_C, display = display.data_window)
plotshape(hm60, "Hammer 60m", shape.triangleup, location.belowbar, HAMMER_C, display = display.data_window)

anyShooter = sh15 or sh30 or sh60
anyHammer  = hm15 or hm30 or hm60
alertcondition(anyShooter, "Shooter at top of range (15/30/60)", "Shooting star at the top of the range on {{ticker}} - put setup")
alertcondition(anyHammer, "Hammer at bottom of range (15/30/60)", "Hammer at the bottom of the range on {{ticker}} - call setup")
alertcondition(anyShooter or anyHammer, "Range setup (shooter or hammer)", "Range setup on {{ticker}} at {{close}}")

tfList(bool a, bool b, bool c) => (a ? "15m " : "") + (b ? "30m " : "") + (c ? "60m " : "")

setupColor = anyShooter ? SHOOT_C : anyHammer ? HAMMER_C : na
barcolor(setupColor)
bgcolor(anyShooter ? color.new(SHOOT_C, 70) : anyHammer ? color.new(HAMMER_C, 70) : na)

if anyShooter
    yTop = math.max(sh15 ? hi15 : high, sh30 ? hi30 : high, sh60 ? hi60 : high)
    label.new(bar_index, yTop, "▼ SHOOTER at TOP\n" + tfList(sh15, sh30, sh60), yloc = yloc.price, style = label.style_label_down, color = SHOOT_C, textcolor = color.white, size = size.large)
if anyHammer
    yBot = math.min(hm15 ? lo15 : low, hm30 ? lo30 : low, hm60 ? lo60 : low)
    label.new(bar_index, yBot, "▲ HAMMER at BOTTOM\n" + tfList(hm15, hm30, hm60), yloc = yloc.price, style = label.style_label_up, color = HAMMER_C, textcolor = color.black, size = size.large)

// One alert for everything: create an alert with condition "Any alert() function call"
px = " at " + str.tostring(close, format.mintick)
if anyShooter
    alert("Shooting star at TOP of range on " + syminfo.ticker + " " + tfList(sh15, sh30, sh60) + "(" + (sh60 ? f60 : sh30 ? f30 : f15) + ")" + px + " - put setup", alert.freq_once_per_bar_close)
if anyHammer
    alert("Hammer at BOTTOM of range on " + syminfo.ticker + " " + tfList(hm15, hm30, hm60) + "(" + (hm60 ? f60 : hm30 ? f30 : f15) + ")" + px + " - call setup", alert.freq_once_per_bar_close)
if newForm and (form == "Broadening" or form == "Cone (contracting)")
    alert(form + " formation on " + syminfo.ticker + " " + timeframe.period + px, alert.freq_once_per_bar_close)
