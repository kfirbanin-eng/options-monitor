# Copy to .env and fill in from https://developer.schwab.com (your app's details).
# Only market data is used. The monitor never calls account or order endpoints.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
# Must exactly match the callback URL registered on your Schwab app
SCHWAB_CALLBACK_URL=https://127.0.0.1
SCHWAB_TOKEN_FILE=tokens.json

# Optional
MONITOR_PORT=8765
QUOTE_POLL_SEC=20
RISK_FREE_RATE=0.04

# Phone push notifications (ntfy app). Long random topic - it works like a password.
NTFY_TOPIC=
